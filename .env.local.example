# Copy to .env.local for local development (gitignored)
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Local MySQL
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
LOCAL_DB_NAME=fgmedia_local
LOCAL_DB_USER=root
LOCAL_DB_PASS=

# Public site URL used in nomination completion email links
PUBLIC_SITE_URL=http://localhost:8080

# Public API URL for email-hosted assets (CEO photo). Local default: http://localhost:3000
PUBLIC_API_URL=http://localhost:3000

# Optional: override awards programme year shown in emails
# AWARDS_PROGRAMME_YEAR=2026

# Razorpay (copy from backend/.env — gitignored)
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_KEY_SECRET=your_live_secret
# RAZORPAY_CHARGE_OVERRIDE_PAISE=10000

# Liveair SMS (optional for local testing)
# LIVEAIR_TOKEN=

# Admin auth (DB-backed JWT)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password123!
# Fallback if ADMIN_PASSWORD unset (bootstrap only)
ADMIN_PASSCODE=password123!
ADMIN_JWT_SECRET=change-me-local-jwt-secret-min-32-chars
