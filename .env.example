PORT=3000
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080,https://fgco.in,https://www.fgco.in

# Local development (copy values to .env.local — see .env.local.example)
LOCAL_DB_HOST=
LOCAL_DB_PORT=3306
LOCAL_DB_NAME=
LOCAL_DB_USER=
LOCAL_DB_PASS=

# Production MySQL (GoDaddy Node.js Hosted Database — injected automatically on hosting)
# DB_HOST=
# DB_PORT=3306
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# Legacy cPanel MySQL (no longer used by the Node app — kept for reference only)
# CPANEL_DB_HOST=
# CPANEL_DB_PORT=3306
# CPANEL_DB_NAME=
# CPANEL_DB_USER=
# CPANEL_DB_PASS=

# Admin auth (DB-backed JWT)
# Bootstrap only used when the admins table is empty
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Fallback bootstrap password during cutover (optional if ADMIN_PASSWORD is set)
ADMIN_PASSCODE=
# Required — signs admin JWTs (use a long random string)
ADMIN_JWT_SECRET=

# Public site URL used in nomination completion email links
PUBLIC_SITE_URL=https://fgco.in

# Public API URL for email-hosted assets (CEO photo). Defaults to PUBLIC_SITE_URL in production.
PUBLIC_API_URL=https://api.fgco.in

# Optional: override awards programme year shown in emails (defaults to current IST calendar year)
# AWARDS_PROGRAMME_YEAR=2026

# SMTP — mail.fgco.in (outgoing SSL port 465)
# Use full email address as SMTP_USER on GoDaddy/cPanel
SMTP_HOST=mail.fgco.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hitawards@fgco.in
SMTP_PASS=
MAIL_FROM=hitawards@fgco.in
MAIL_FROM_NAME=FG Media Group

# Incoming mail (reference — IMAP/POP3)
IMAP_HOST=mail.fgco.in
IMAP_PORT=993
POP3_PORT=995

# Local file uploads (used when R2 is not configured)
LOCAL_UPLOAD_DIR=./uploads

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: Resend / MSG91 if used alongside SMTP
RESEND_API_KEY=
MSG91_AUTH_KEY=
