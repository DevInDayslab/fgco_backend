PORT=3000
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173,https://fgco.in,https://www.fgco.in

# Local development (copy values to .env.local — see .env.local.example)
LOCAL_DB_HOST=
LOCAL_DB_PORT=3306
LOCAL_DB_NAME=
LOCAL_DB_USER=
LOCAL_DB_PASS=

# Production MySQL (GoDaddy cPanel — set only in hosting dashboard)
CPANEL_DB_HOST=
CPANEL_DB_PORT=3306
CPANEL_DB_NAME=
CPANEL_DB_USER=
CPANEL_DB_PASS=

# Admin API passcode (must match frontend VITE_ADMIN_PASSCODE)
ADMIN_PASSCODE=

# SMTP — mail.fgco.in (outgoing SSL port 465)
SMTP_HOST=mail.fgco.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=FG Media Hub

# Incoming mail (reference — IMAP/POP3)
IMAP_HOST=mail.fgco.in
IMAP_PORT=993
POP3_PORT=995

# Local file uploads (used when R2 is not configured)
LOCAL_UPLOAD_DIR=./uploads

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: Resend / MSG91 if used alongside SMTP
RESEND_API_KEY=
MSG91_AUTH_KEY=
